# Frontend domains
REACT_APP_MYJOB_HOST_NAME=imyanya.rw
REACT_APP_EMPLOYER_MYJOB_HOST_NAME=employers.imyanya.rw

# Backend OAuth client used by the current frontend token flow.
# Prefer moving any secret-bearing token exchange to the backend.
REACT_APP_MYJOB_SERVER_CLIENT_ID=
REACT_APP_MYJOB_SERVER_CLIENT_SECRET=

# Social login public client IDs
REACT_APP_FACEBOOK_CLIENT_ID=
REACT_APP_GOOGLE_CLIENT_ID=

# Current code still reads these for token conversion. Do not expose provider
# client secrets in long-term production; rotate them after moving conversion
# server-side.
REACT_APP_FACEBOOK_CLIENT_SECRET=
REACT_APP_GOOGLE_CLIENT_SECRET=

# Maps / location
REACT_APP_GOONGAPI_KEY=
REACT_APP_GOONGAPI_ACCESS_TOKEN=

# Chatbot IDs
REACT_APP_JOB_SEEKER_BOT_AGENT_ID=
REACT_APP_EMPLOYER_BOT_AGENT_ID=

# Firebase public web config
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_DATABASE_URL=
